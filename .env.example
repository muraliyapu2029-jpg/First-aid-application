# RakshaAI Environment Variables
# Copy this file to .env and fill in values as needed

# Sarvam AI API Key (Recommended for automatic language detection, conversational AI, and voice output)
# Supports 11 Indian languages + English automatically via Saaras STT, Sarvam Chat, and Bulbul TTS
VITE_SARVAM_API_KEY=
SARVAM_API_KEY=

# Optional: Gemini API key for fallback AI classification
VITE_GEMINI_API_KEY=

# OpenStreetMap Overpass API URL (default shown below)
VITE_OVERPASS_API_URL=https://overpass-api.de/api/interpreter
