# RakshaAI Environment Variables
# Copy this file to .env and fill in values as needed
# The app works without any API keys — AI detection is optional

# Optional: Gemini API key for AI-enhanced emergency detection
# Leave empty to use rule-based detection (works offline)
VITE_GEMINI_API_KEY=

# OpenStreetMap Overpass API URL (default shown below)
# Change only if you are running your own Overpass instance
VITE_OVERPASS_API_URL=https://overpass-api.de/api/interpreter
